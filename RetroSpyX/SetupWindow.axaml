<?xml version="1.0"?>
<!-- RetroSpy's setup window. Phosphor edition (f3bandit): Phosphor's look, the sources in a list on the left, and the
     SuperStation (Phosphor) source's own panel. Every source and option RetroSpy has is still here. -->
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680" Width="1000" Height="680" MinWidth="860" MinHeight="600"
    x:Class="RetroSpy.SetupWindow" Title="RetroSpy · Phosphor edition">

    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="13">
            <MenuItem Header="_Tools">
                <MenuItem x:Name="ReloadSkins" Header="Reload Skins" Click="ReloadSkins_Click"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem x:Name="AddRemove" Header="Add/Remove Sources..." Click="AddRemove_Click"/>
                <MenuItem x:Name="CustomSkinPath" Header="Custom Skin Path..." Click="CustomSkinPath_Click"/>
                <Separator/>
                <MenuItem x:Name="KeybindingBehavior" Header="Legacy Keybinding Behavior" Click="KeybindingBehavior_Checked">
                    <MenuItem.Icon><CheckBox Name="KeybindingCheckbox" Width="20" BorderThickness="0" IsChecked="{Binding LegacyKeybindingBehavior}" Click="KeybindingBehavior_Checked"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="FilterCOM" Header="Don't Filter COM Ports" Click="FilterCOM_Checked">
                    <MenuItem.Icon><CheckBox Name="FilterCOMCheckbox" Width="20" BorderThickness="0" IsChecked="{Binding FilterCOMPorts}" Click="FilterCOM_Checked"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="DoNotSavePassword" Header="Don't Save Passwords" Click="DoNotSavePassword_Checked">
                    <MenuItem.Icon><CheckBox Name="DoNotSavePasswordCheckbox" Width="20" BorderThickness="0" IsChecked="{Binding DontSavePassword}" Click="DoNotSavePassword_Checked"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="LagFix" Header="Need Lag Fix" Click="LagFix_Checked">
                    <MenuItem.Icon><CheckBox Name="LagFixCheckbox" Width="20" BorderThickness="0" IsChecked="{Binding UseLagFix}" Click="LagFix_Checked"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="UseUSB2" Header="Use USB Lite" Click="UseUSB2_Checked">
                    <MenuItem.Icon><CheckBox Name="UseUSB2Checkbox" Width="20" BorderThickness="0" IsChecked="{Binding UseUSB2}" Click="UseUSB2_Checked"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="UseVJoy" Header="Enable vJoy" Click="UseVJoy_Checked">
                    <MenuItem.Icon><CheckBox Name="UseVJoyCheckbox" Width="20" BorderThickness="0" IsChecked="{Binding UseVJoy}" Click="UseVJoy_Checked"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="About" Header="About and credits" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid ColumnDefinitions="260,*">
            <!-- the sources -->
            <Border Grid.Column="0" BorderBrush="{StaticResource PhLine}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="h" Text="SOURCE" Margin="10,0,0,10"/>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource PhFaint}" FontSize="12" TextWrapping="Wrap" Margin="10,10,4,0"
                               Text="Options › Add/Remove Sources picks which ones are listed."/>
                    <ListBox Name="SourcesComboBox" ItemsSource="{Binding Sources}" SelectedItem="{Binding Sources.SelectedItem}"
                             SelectionChanged="SourceSelectComboBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- the selected source -->
            <DockPanel Grid.Column="1" Margin="26,18,26,16">
                <!-- footer: start, credits -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Button Name="goButton" Classes="primary" Content="Start watching" Click="GoButton_Click"/>
                        <CheckBox x:Name="staticViewerNameCheckbox" Content="Static window name (for OBS)" IsChecked="{Binding StaticViewerWindowName}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border BorderBrush="{StaticResource PhLine}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <TextBlock Foreground="{StaticResource PhFaint}" FontSize="12" TextWrapping="Wrap"
                                   Text="RetroSpy by zoggins and contributors (retro-spy.com), based on NintendoSpy by jaburns; skins by their authors. GPL-3.0. Phosphor edition by f3bandit. Help › About and credits."/>
                    </Border>
                </StackPanel>

                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding SourceName}" FontSize="22" FontWeight="SemiBold"/>

                        <!-- SuperStation (Phosphor) -->
                        <Border Classes="card" IsVisible="{Binding PhosphorOptionVisibility}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="h" Text="ACTIVE CONTROLLER"/>
                                    <TextBlock Text="{Binding PhosphorTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PhosphorDetail}" FontSize="13" Foreground="{StaticResource PhMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Name="PhosphorFind" Content="Find the SuperStation" VerticalAlignment="Top" Click="PhosphorFind_Click"/>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,14,*,14,*" Margin="0,14,0,0">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="field" Text="Controller to show"/>
                                        <ComboBox Name="PhosphorPlayerCombo" HorizontalAlignment="Stretch" SelectedIndex="{Binding PhosphorPlayer}">
                                            <ComboBoxItem>The active one (Player 1)</ComboBoxItem>
                                            <ComboBoxItem>Player 1</ComboBoxItem>
                                            <ComboBoxItem>Player 2</ComboBoxItem>
                                            <ComboBoxItem>Player 3</ComboBoxItem>
                                            <ComboBoxItem>Player 4</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="field" Text="Look"/>
                                        <ComboBox Name="PhosphorLookCombo" HorizontalAlignment="Stretch" SelectedIndex="{Binding PhosphorLook}">
                                            <ComboBoxItem>Phosphor layout</ComboBoxItem>
                                            <ComboBoxItem>A RetroSpy skin</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Classes="field" Text="Background"/>
                                        <ComboBox Name="PhosphorBackgroundCombo" HorizontalAlignment="Stretch" SelectedIndex="{Binding PhosphorBackground}" IsEnabled="{Binding PhosphorUsesLayout}">
                                            <ComboBoxItem>Dark</ComboBoxItem>
                                            <ComboBoxItem>Green screen</ComboBoxItem>
                                            <ComboBoxItem>Transparent</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- connection and the source's own settings -->
                        <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" IsVisible="{Binding SSHOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock Name="HostnameLabel" Classes="field" Text="Address (host name or IP)"/>
                                <TextBox Name="txtHostname" Text="{Binding Hostname}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" IsVisible="{Binding SSHOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock x:Name="UsernameLabel" Classes="field" Text="User name"/>
                                <TextBox x:Name="txtUsername"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" IsVisible="{Binding SSHOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock x:Name="PasswordLabel" Classes="field" Text="Password"/>
                                <TextBox x:Name="txtPassword" PasswordChar="•" RevealPassword="false"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" IsVisible="{Binding ComPortOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock Name="ComPortLabel" Classes="field" Text="COM port"/>
                                <ComboBox Name="ComPortCombo" HorizontalAlignment="Stretch" ItemsSource="{Binding Ports}" SelectedItem="{Binding Ports.SelectedItem}" SelectionChanged="ComPortCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" IsVisible="{Binding ComPort2OptionVisibility}" Margin="0,0,0,12">
                                <TextBlock x:Name="ComPort2Label_Copy" Classes="field" Text="COM port 2"/>
                                <ComboBox Name="ComPort2Combo" HorizontalAlignment="Stretch" ItemsSource="{Binding Ports2}" SelectedItem="{Binding Ports2.SelectedItem}" SelectionChanged="ComPortCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" IsVisible="{Binding XIAndGamepadOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock Name="ControllerIdLabel" Classes="field" Text="Controller"/>
                                <ComboBox Name="ControllerIdCombo" HorizontalAlignment="Stretch" ItemsSource="{Binding XIAndGamepad}" SelectedItem="{Binding XIAndGamepad.SelectedItem}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" IsVisible="{Binding EmulatorPIDsOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock Name="EmulatorPIDLabel" Classes="field" Text="Emulator (PID)"/>
                                <ComboBox Name="EmulatorPIDsCombo" HorizontalAlignment="Stretch" ItemsSource="{Binding EmulatorPIDs}" SelectedItem="{Binding EmulatorPIDs.SelectedItem}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" IsVisible="{Binding MiSTerGamepadOptionVisibility}" Margin="0,0,0,12">
                                <TextBlock Name="MisterControllerIdLabel" Classes="field" Text="Controller (jsN)"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ComboBox Name="MisterControllerIdCombo" MinWidth="120" ItemsSource="{Binding MisterGamepad}" SelectedItem="{Binding MisterGamepad.SelectedItem}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Name="MiSTerPopulate" Content="Detect" Click="MiSTerPopulate_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock x:Name="DelayLabel" Classes="field" Text="Delay (ms)"/>
                                <TextBox Name="txtDelay" Text="0" Classes="NumberOnly" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- skins and backgrounds -->
                        <Grid ColumnDefinitions="3*,14,2*" IsVisible="{Binding SkinsVisibility}">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="field" Text="Skin"/>
                                <ListBox Name="SkinListBox" Classes="list" Height="200" ItemsSource="{Binding Skins}" SelectedItem="{Binding Skins.SelectedItem}" SelectionChanged="Skin_SelectionChanged">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field" Text="Background"/>
                                <ListBox Name="BackgroundListBox" Classes="list" Height="200" ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding Backgrounds.SelectedItem}">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
